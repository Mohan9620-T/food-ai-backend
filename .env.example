# Required: Use 127.0.0.1 for local Uvicorn (Compose publishes IPv4 only), or postgres inside Compose.
DB_HOST=127.0.0.1
# Required: PostgreSQL port.
DB_PORT=5432
# Required: PostgreSQL database name.
DB_NAME=food_ai
# Required: PostgreSQL user name.
DB_USER=food_ai
# Required: PostgreSQL password; replace this placeholder with a strong local secret.
DB_PASSWORD=replace_with_a_strong_database_password
# Railway: set this to ${{Postgres.DATABASE_URL}} in the service Variables tab.
# Local/Compose: leave empty to build it from DB_* (PG* variables also work).
DATABASE_URL=
# Railway injects PORT; the container uses it automatically (local default 8000).

# Required: Secret used to sign JWTs; replace with a long, random value.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
# Optional: Standard access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional: Remember-me access-token lifetime in days.
REMEMBERED_ACCESS_TOKEN_EXPIRE_DAYS=30

# Account mail: one sender can deliver to Gmail, Microsoft 365, Outlook and other domains.
# Railway Trial/Hobby blocks SMTP: use resend, gmail or microsoft (HTTPS).
# auto preserves existing SMTP setups; disabled explicitly turns mail off.
EMAIL_PROVIDER=auto
PUBLIC_APP_URL=http://localhost:4200
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Food AI Assistant
# For Gmail / delegated Microsoft OAuth, generate a Fernet key and keep it stable.
EMAIL_TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REFRESH_TOKEN=
# SMTP is available locally or on Railway Pro+; use app passwords where supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# For port 465, use SSL (takes precedence over STARTTLS).
SMTP_USE_SSL=false

# Optional: Ollama chat API URL; the default reaches Ollama from a host-run backend.
OLLAMA_URL=http://localhost:11434/api/chat
# Optional: Ollama model used for text chat; pull it before use.
OLLAMA_MODEL=qwen3:8b
# Optional: Text-model request timeout in seconds.
OLLAMA_TIMEOUT_SECONDS=300
# Optional: Fail quickly when Ollama cannot be reached; generation still uses the timeout above.
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# Optional: How long Ollama keeps a loaded model resident.
OLLAMA_KEEP_ALIVE=1h
# Optional: Enable Qwen reasoning output; false gives faster normal chat responses.
OLLAMA_CHAT_THINK=false
# Optional: Maximum number of tokens generated for a text-chat response.
OLLAMA_CHAT_MAX_TOKENS=2048
# Optional: Ollama vision model used for meal-image parsing; pull it before use.
OLLAMA_VISION_MODEL=qwen3-vl:4b
# Optional: Meal-image model timeout in seconds.
OLLAMA_VISION_TIMEOUT_SECONDS=660
# Optional: Longest image edge sent to vision models; stored originals remain unchanged.
OLLAMA_VISION_MAX_DIMENSION=1024
# Optional: Ollama vision model used for general image chat; pull it before use.
OLLAMA_CHAT_VISION_MODEL=qwen3-vl:4b
# Optional: General image-chat timeout in seconds.
OLLAMA_CHAT_VISION_TIMEOUT_SECONDS=660

# Optional development override: ollama is local-only; nvidia tests NVIDIA-first
# failover. APP_ENVIRONMENT=production always uses NVIDIA then Ollama.
APP_ENVIRONMENT=development
LLM_PROVIDER=ollama
# Required for NVIDIA primary routing. Get a free key at
# https://build.nvidia.com/settings/api-keys (starts with nvapi-).
NVIDIA_API_KEY=
# Optional: NVIDIA's OpenAI-compatible API base URL.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: NVIDIA text-only chat model.
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: NVIDIA text connection timeout in seconds.
NVIDIA_CHAT_CONNECT_TIMEOUT_SECONDS=5
# Optional: NVIDIA text response-read timeout in seconds.
NVIDIA_CHAT_TIMEOUT_SECONDS=30
# Non-streaming answers wait for the complete response, rather than each token.
NVIDIA_CHAT_COMPLETE_TIMEOUT_SECONDS=120
# Optional: NVIDIA answer token budget, independent of the local Ollama limit.
NVIDIA_CHAT_MAX_TOKENS=4096
# Optional: Brief reasoning for Nemotron 3 Super text chat; 0 disables it.
# Reasoning tokens are added to the answer budget, never subtracted from it.
NVIDIA_CHAT_REASONING_BUDGET=1024
# Continue an unfinished chat answer automatically, up to three additional requests.
CHAT_MAX_CONTINUATIONS=3
# Optional: conversational chat sampling temperature (kept low-variance for a coherent,
# on-topic reply). Document generation/analysis uses DOCUMENT_AI_TEMPERATURE instead.
CHAT_TEMPERATURE=0.3
# Optional: sampling temperature for document generation/analysis and JSON planning calls.
DOCUMENT_AI_TEMPERATURE=0.2
# Optional: nucleus sampling (top_p) sent to NVIDIA chat models.
NVIDIA_CHAT_TOP_P=0.9
# Optional: rough characters-per-token estimate used only to budget how much
# chat history fits in a request; not an exact tokenizer count.
CONTEXT_TOKEN_CHAR_DIVISOR=4
# Optional: approximate input-token budget for system prompt + memory + history +
# document context + the current message, leaving headroom for the model's answer.
# Keep this well above SYSTEM_PROMPT's own size (~4200 estimated tokens) plus a
# full 24-message history window, or it will override that window every turn.
CONTEXT_TOKEN_BUDGET=24000
# Optional: Total document AI deadline, including all provider attempts and tokens.
# Direct text export does not use an AI provider or this deadline.
DOCUMENT_AI_TIMEOUT_SECONDS=90
# Optional: response budget for document Q&A and generated document structure.
DOCUMENT_AI_MAX_TOKENS=2048
# Optional: Larger budget for complete generated document structures.
DOCUMENT_GENERATION_MAX_TOKENS=8192
DOCUMENT_PLAN_CONFIDENCE_THRESHOLD=0.65
# Optional: full path to soffice for layout-preserving DOCX/PPTX to PDF conversion.
# Leave empty to discover LibreOffice on PATH or in its standard Windows install location.
LIBREOFFICE_BINARY=
# Optional: full path to tesseract; PATH and standard Windows locations are detected.
TESSERACT_BINARY=
DOCUMENT_PIPELINE_MAX_STEPS=8
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=90
# Pre-parse limits for DOCX/XLSX/PPTX zip/XML containers.
DOCUMENT_OOXML_MAX_UNCOMPRESSED_BYTES=134217728
DOCUMENT_OOXML_MAX_TOTAL_RATIO=100
DOCUMENT_OOXML_MAX_ENTRY_RATIO=200
DOCUMENT_OOXML_MAX_ENTRIES=5000
# Optional: model used only by the /nvidia-chat diagnostic endpoint.
NVIDIA_TEST_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional: response timeout for the /nvidia-chat diagnostic endpoint.
NVIDIA_TEST_CHAT_TIMEOUT_SECONDS=60
# Optional: NVIDIA vision model.
NVIDIA_CHAT_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Optional: NVIDIA vision connection timeout in seconds.
NVIDIA_VISION_CONNECT_TIMEOUT_SECONDS=5
# Optional: NVIDIA vision response-read timeout in seconds.
NVIDIA_VISION_TIMEOUT_SECONDS=45
# Optional: longest image edge sent to NVIDIA; stored originals remain unchanged.
NVIDIA_VISION_MAX_DIMENSION=768
# Optional: maximum NVIDIA response tokens.
NVIDIA_VISION_MAX_TOKENS=2048
# Optional: run a second local Tesseract OCR pass; disabled for lower latency.
CHAT_VISION_OCR_ENABLED=false
# Optional: whether /health/ready requires Ollama to be reachable. Keep true for
# the default local/Docker Compose topology (Ollama always runs). Set to false
# only for a deployment that intentionally doesn't run Ollama at all (e.g. an
# NVIDIA-only production deployment) - Ollama's status is still reported for
# visibility, it just no longer gates readiness.
OLLAMA_REQUIRED_FOR_READINESS=true

# Optional: USDA FoodData Central API key; nutrition lookup is limited when empty.
USDA_API_KEY=
# Optional: USDA FoodData Central API base URL.
USDA_API_URL=https://api.nal.usda.gov/fdc/v1
# Optional: USDA API request timeout in seconds.
USDA_TIMEOUT_SECONDS=15

# Optional: cache recently-assembled chat history in Redis. Postgres remains the
# source of truth; chat keeps working unchanged when this is false or Redis is down.
ENABLE_REDIS_CACHE=false
# Optional: full Redis connection URL; overrides the REDIS_HOST/PORT/DB/PASSWORD below.
REDIS_URL=
# Optional: Redis host reachable from the backend (use "redis" inside Compose).
REDIS_HOST=localhost
# Optional: Redis port.
REDIS_PORT=6379
# Optional: Redis logical database index.
REDIS_DB=0
# Optional: Redis password; leave empty when the Redis instance has no auth configured.
REDIS_PASSWORD=
# Optional: Redis connect/read timeout in seconds.
REDIS_TIMEOUT_SECONDS=2
# Optional: how long cached chat history stays valid before a fresh Postgres read.
REDIS_CHAT_TTL_SECONDS=3600

# Optional: semantically index uploaded documents in ChromaDB and retrieve relevant
# excerpts instead of injecting a whole document. Additive to (never a replacement
# for) the deterministic raw_text path; chat keeps working unchanged when this is
# false or Chroma/the embedding provider is unreachable.
ENABLE_SEMANTIC_RAG=false
# Optional: Chroma host reachable from the backend (use "chroma" inside Compose).
CHROMA_HOST=localhost
# Optional: Chroma port.
CHROMA_PORT=8000
# Optional: prefix for the Chroma collection name.
CHROMA_COLLECTION_PREFIX=foodai
# Optional: Chroma connect/read timeout in seconds.
CHROMA_TIMEOUT_SECONDS=10
# Optional: "nvidia" tries NVIDIA embeddings with an Ollama fallback; "ollama" stays
# fully local (no NVIDIA call for embeddings at all).
EMBEDDING_PROVIDER=nvidia
# Optional: NVIDIA embedding model. Verify against the current NVIDIA NIM catalog -
# hosted embedding models are periodically retired; nvidia/nemotron-3-embed-1b was
# confirmed working at the time this was written.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Optional: Ollama embedding model; pull it separately from the chat/vision models.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional: number of chunks requested from Chroma per query, before filtering.
RAG_TOP_K=5
# Optional: minimum cosine similarity (0-1) for a chunk to be used; below this the
# assistant is told to say the document doesn't cover the question, not guess.
# Calibrated live against nvidia/nemotron-3-embed-1b: true matches scored
# ~0.30-0.47, unrelated queries ~0.01-0.05. Recalibrate if you change models.
RAG_SIMILARITY_THRESHOLD=0.2
# Optional: maximum number of chunks injected into one chat turn.
RAG_MAX_CONTEXT_CHUNKS=6
# Optional: maximum estimated tokens of retrieved chunk text injected into one turn.
RAG_MAX_CONTEXT_TOKENS=2000
# Optional: target size, in characters, of each indexed chunk.
RAG_CHUNK_CHARS=800
# Optional: character overlap between consecutive chunks of the same block.
RAG_CHUNK_OVERLAP_CHARS=100

# Automatic factual-question lookup. Public links and Wikipedia work without a
# search key when enabled; broad web/news/jobs searches require TAVILY_API_KEY.
ENABLE_WEB_SEARCH=false
WIKIPEDIA_SEARCH_ENABLED=true
TAVILY_API_KEY=
TAVILY_API_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=10
# Optional: number of search results requested per query.
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_TIMEOUT_SECONDS=12

# Comma-separated browser origins allowed by CORS. Set exact frontend URLs in production.
# APP_ENVIRONMENT=development also allows HTTP(S) localhost/127.0.0.1/[::1] on any port.
ALLOWED_ORIGINS=http://localhost:4200
# Optional: Login endpoint rate limit in SlowAPI format.
LOGIN_RATE_LIMIT=5/minute
# Optional: Registration endpoint rate limit in SlowAPI format.
REGISTER_RATE_LIMIT=5/minute
# Optional: Meal-creation endpoint rate limit in SlowAPI format.
MEAL_CREATE_RATE_LIMIT=10/minute
# Optional: Image-chat endpoint rate limit in SlowAPI format.
CHAT_VISION_RATE_LIMIT=2/minute
# Optional: Warn during startup when Alembic migrations are pending.
MIGRATION_CHECK_ENABLED=true
