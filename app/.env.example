DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBERED_ACCESS_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_KEEP_ALIVE=1h
OLLAMA_CHAT_THINK=false
OLLAMA_CHAT_MAX_TOKENS=256
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_VISION_TIMEOUT_SECONDS=660
OLLAMA_VISION_MAX_DIMENSION=1024

# Text and vision models can take several minutes on CPU-only hardware.
# Requests within OLLAMA_KEEP_ALIVE are noticeably faster because Ollama keeps the
# most recently used model resident in RAM. The first request after starting Ollama,
# or after a longer idle gap/model switch, is still a cold request and may be slow.
# General multimodal chat remains separate from meal-photo parsing.
# Required local setup: ollama pull qwen3-vl:4b
# Also pull the general text model: ollama pull qwen3:8b
OLLAMA_CHAT_VISION_MODEL=qwen3-vl:4b
OLLAMA_CHAT_VISION_TIMEOUT_SECONDS=660

# Which backend answers general image-chat questions: "ollama" (local,
# private, free-forever) or "nvidia" (hosted API, free credits, requires
# internet, sends images to NVIDIA's cloud). Defaults to ollama.
LLM_PROVIDER=ollama
# Required only if LLM_PROVIDER=nvidia. Get a free key at
# https://build.nvidia.com/settings/api-keys (starts with nvapi-).
NVIDIA_API_KEY=
# Optional: NVIDIA's OpenAI-compatible API base URL.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: override the NVIDIA vision model used when LLM_PROVIDER=nvidia.
NVIDIA_CHAT_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# Optional: NVIDIA vision request timeout in seconds.
NVIDIA_VISION_TIMEOUT_SECONDS=180

USDA_API_KEY=
USDA_API_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_SECONDS=15

ALLOWED_ORIGINS=http://localhost:4200
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute
MEAL_CREATE_RATE_LIMIT=10/minute
CHAT_VISION_RATE_LIMIT=2/minute
MIGRATION_CHECK_ENABLED=true
